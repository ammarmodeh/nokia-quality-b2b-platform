# MongoDB connection URI (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reachb2bProject_2026

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Environment ('development' or 'production')
NODE_ENV=development

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins (supports comma-separated list of local and production URLs)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://nokia-quality-b2b-platform-bfrq.vercel.app,https://nokia-quality-b2b-platform.vercel.app

# AWS S3 Configuration (Audit upload bucket)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=reach-field-audit-user-bucket

